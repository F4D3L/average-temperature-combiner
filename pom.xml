<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.pucpr.bigdata</groupId>
    <artifactId>average-temperature-combiner</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Temperatura Média com Combiner (MapReduce)</name>
    <description>Temperatura média do forestfireinput.csv calculada com Hadoop MapReduce, otimizada com Combiner.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode Java 8, para o jar rodar também nas máquinas do laboratório com JVM mais antiga. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <hadoop.version>3.3.6</hadoop.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Código e recursos ficam direto em src/, sem a estrutura src/main/java padrão do Maven. -->
        <sourceDirectory>src</sourceDirectory>
        <resources>
            <resource>
                <directory>src</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- Permite rodar o job com: hadoop jar average-temperature-combiner-1.0.0.jar <entrada> <saída> -->
                            <mainClass>AverageTemperature</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- mvn compile exec:java roda o job no modo local do Hadoop, sem precisar de cluster. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>AverageTemperature</mainClass>
                    <arguments>
                        <argument>input/forestfireinput.csv</argument>
                        <argument>target/output</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
